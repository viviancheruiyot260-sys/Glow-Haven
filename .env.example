FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret

USE_SQLITE=0

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=glow_haven
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD

# --- M-Pesa Daraja (sandbox) — see docs/MPESA_SANDBOX.md ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Leave empty to use sandbox default 174379
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS URL, e.g. https://xxxx.ngrok-free.app/api/payments/mpesa/callback
MPESA_CALLBACK_URL=

# Production API (comma-separated storefront origins allowed to call /api)
# CORS_ORIGINS=https://your-app.vercel.app,https://www.yourdomain.com

# Managed DB (preferred on Render/Railway instead of USE_SQLITE)
# DATABASE_URI=mysql+pymysql://user:pass@host:3306/glow_haven?charset=utf8mb4

# FLASK_DEBUG=0
# PORT=5000
